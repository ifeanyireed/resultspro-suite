PORT=8082
ENV=development
ALLOWED_ORIGINS="*"

# Neon Serverless Postgres
DATABASE_URL="postgresql://<user>:<password>@<neon-hostname>/<database>?channel_binding=require&sslmode=require"

# JWT Security
JWT_SECRET="your-jwt-secret-min-32-chars"

# Upstash Redis & Namespace Caching
REDIS_URL=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_ENV="development"
