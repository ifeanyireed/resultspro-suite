{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@classroompro/*": ["../../classroompro/src/*"],
      "@resultspro/*": ["../../resultspro/src/*"],
      "@tutorspro/*": ["../../tutorspro/src/*"],
      "@puzzlepro/*": ["../../puzzlepro/src/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"],
      "next": ["./node_modules/next"],
      "next/*": ["./node_modules/next/*"],
      "framer-motion": ["./node_modules/framer-motion"],
      "@tabler/icons-react": ["./node_modules/@tabler/icons-react"],
      "gsap": ["./node_modules/gsap"],
      "axios": ["./node_modules/axios"],
      "zustand": ["./node_modules/zustand"],
      "@heroicons/react/*": ["./node_modules/@heroicons/react/*"],
      "hugeicons-react": ["./node_modules/hugeicons-react"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
