package handlers

import (
	"encoding/json"
	"log"
	"net/http"
	"os"
	"strings"
	"time"

	"service_users.resultspro.ng/db"
	"service_users.resultspro.ng/models"
	"service_users.resultspro.ng/services"
	"service_users.resultspro.ng/utils"
)

// HandleProvisionTenantDVA provisions a Paystack Subaccount and Dedicated Virtual Account for a tenant
func HandleProvisionTenantDVA(w http.ResponseWriter, r *http.Request) {
	if r.Method != http.MethodPost {
		utils.JSONError(w, http.StatusMethodNotAllowed, "Method not allowed")
		return
	}

	parts := strings.Split(r.URL.Path, "/")
	tenantID := ""
	for i, part := range parts {
		if part == "provision-dva" && i+1 < len(parts) {
			tenantID = parts[i+1]
			break
		}
	}

	if tenantID == "" {
		utils.JSONError(w, http.StatusBadRequest, "Tenant ID required")
		return
	}

	var req struct {
		BankCode      string `json:"bank_code"`
		AccountNumber string `json:"account_number"` // The tenant's real settlement account number
	}

	if err := json.NewDecoder(r.Body).Decode(&req); err != nil {
		utils.JSONError(w, http.StatusBadRequest, "Invalid request body")
		return
	}

	// 1. Fetch Tenant
	var tenant models.Tenant
	if err := db.GormDB.First(&tenant, "id = ?", tenantID).Error; err != nil {
		utils.JSONError(w, http.StatusNotFound, "Tenant not found")
		return
	}

	if tenant.PaymentMode == "byo_paystack" {
		utils.JSONError(w, http.StatusBadRequest, "Tenant uses BYO Paystack. Cannot provision platform DVA.")
		return
	}

	// 2. Initialize Paystack Client
	secretKey := os.Getenv("PAYSTACK_SECRET_KEY")
	if secretKey == "" {
		utils.JSONError(w, http.StatusInternalServerError, "Platform Paystack keys not configured")
		return
	}
	paystack := services.NewPaystackClient(secretKey)

	// 3. Create Subaccount if not exists
	if tenant.PaystackSubaccountCode == "" {
		subaccountCode, err := paystack.CreateSubaccount(
			tenant.Name,
			req.BankCode,
			req.AccountNumber,
			tenant.PlatformFeePercent,
		)
		if err != nil {
			log.Printf("Failed to create subaccount for %s: %v", tenant.Name, err)
			utils.JSONError(w, http.StatusInternalServerError, "Failed to provision Paystack Subaccount: "+err.Error())
			return
		}
		tenant.PaystackSubaccountCode = subaccountCode
		db.GormDB.Save(&tenant)
	}

	// 4. Create Paystack Customer (if not exists) to attach DVA to
	if tenant.PaystackCustomerCode == "" {
		customerEmail := tenant.ContactEmail
		if customerEmail == "" {
			customerEmail = tenant.Slug + "@coursespro.com"
		}
		
		customerCode, err := paystack.CreateCustomer(
			customerEmail,
			tenant.Name,
			"LMS",
			tenant.ContactPhone,
		)
		if err != nil {
			log.Printf("Failed to create paystack customer for %s: %v", tenant.Name, err)
			utils.JSONError(w, http.StatusInternalServerError, "Failed to provision Paystack Customer: "+err.Error())
			return
		}
		tenant.PaystackCustomerCode = customerCode
		db.GormDB.Save(&tenant)
	}

	// 5. Create DVA
	dvaResp, err := paystack.CreateDedicatedVirtualAccount(tenant.PaystackCustomerCode, tenant.PaystackSubaccountCode, "titan-paystack")
	if err != nil {
		log.Printf("Failed to create DVA for %s: %v", tenant.Name, err)
		
		tenant.DvaStatus = "failed"
		tenant.PaystackStatus = "failed"
		db.GormDB.Save(&tenant)
		
		utils.JSONError(w, http.StatusInternalServerError, "Failed to provision DVA: "+err.Error())
		return
	}

	// 6. Update Tenant Success
	tenant.DvaAccountNumber = dvaResp.AccountNumber
	tenant.DvaBank = dvaResp.BankName
	tenant.DvaStatus = "active"
	tenant.PaystackStatus = "Active"
	db.GormDB.Save(&tenant)

	utils.JSONResponse(w, http.StatusOK, map[string]interface{}{
		"message": "DVA provisioned successfully",
		"dva":     dvaResp,
	})
}
