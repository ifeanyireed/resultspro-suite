# PuzzlePro Frontend Environment Configuration
# Consolidated Microservice Architecture

# service_puzzlepro (Game Engine, Worlds, Adventures, Levels & Waypoints)
NEXT_PUBLIC_GAME_ENGINE_URL=https://resultspro-service-puzzlepro.onrender.com

# service_users (Player Identity, Profiles, Tenancy, Groups & Subscriptions)
NEXT_PUBLIC_PLAYER_SERVICE_URL=https://resultspro-service-users.onrender.com
NEXT_PUBLIC_USERS_API=https://resultspro-service-users.onrender.com

# Cloudinary CDN Configuration
NEXT_PUBLIC_CDN_URL=https://res.cloudinary.com/<cloud_name>/image/upload/f_auto,q_auto/puzzlepro/assets
NEXT_PUBLIC_BUILD_VERSION=2.1.1_v1

# Cloudinary Asset Sync Deployment Secret
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
